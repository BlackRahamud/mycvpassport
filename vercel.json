{
  "functions": {
    "api/generate-pdf.js": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/transform.js": {
      "maxDuration": 60
    },
    "api/create-ziina-payment.js": {
      "maxDuration": 15
    },
    "api/ziina-webhook.js": {
      "maxDuration": 15
    },
    "api/notify-candidate.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(?:woff2?|ttf|otf|eot)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)\\.(?:png|jpg|jpeg|gif|svg|webp|avif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon.(?:ico|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    { "source": "/walk-in-cv",    "destination": "/walk-in",      "permanent": true },
    { "source": "/ats-checker",   "destination": "/ats",          "permanent": true },
    { "source": "/indian-cv-uae", "destination": "/india-to-uae", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "missing": [
        { "type": "header", "key": "x-prerender-bypass" },
        { "type": "query",  "key": "__cvp_spa" }
      ],
      "destination": "/api/prerender"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
