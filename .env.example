# Razorpay — INR payments (India market)
# Key ID is safe to expose client-side; secret stays server-only.
REACT_APP_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_SECRET=your_razorpay_secret
# From Razorpay Dashboard → Webhooks → your webhook → Secret
# Webhook URL: https://mycvpassport.com/api/razorpay?action=webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Set this in the Vercel project's Environment Variables for all environments.
PRERENDER_TOKEN=your-prerender-io-token-here

# Microsoft Clarity — heatmaps + session replay. Project ID from
# https://clarity.microsoft.com/projects. Disabled in dev unless
# REACT_APP_ANALYTICS_FORCE=true.
REACT_APP_CLARITY_PROJECT_ID=your-clarity-project-id

# PostHog — product analytics + funnels. Project key + region host from
# https://eu.posthog.com/project/settings (or app.posthog.com for US).
# Disabled in dev unless REACT_APP_ANALYTICS_FORCE=true.
REACT_APP_POSTHOG_KEY=phc_your-posthog-project-key
REACT_APP_POSTHOG_HOST=https://eu.i.posthog.com

# Force-enable analytics (Clarity, PostHog) in non-production builds for
# local QA. Leave unset in production — production runs analytics by default.
REACT_APP_ANALYTICS_FORCE=false

# ─── Launch offer (2-week promo) master switch ───────────────────────────────
# The offer's effective state is (enabled AND now <= 2026-08-07T23:59:59).
# When off/expired the app auto-reverts to the original plan (1 download,
# free-templates-only nudge). The 3-import free allowance is unaffected.
#
# SET BOTH to the SAME value, for ALL environments, and REDEPLOY to flip:
#   • REACT_APP_LAUNCH_OFFER_ENABLED — read by the browser (client UI + gates).
#   • LAUNCH_OFFER_ENABLED           — read by the Vercel functions (server
#                                      enforcement of the 3-download limit).
# The server can only read the env var (not the PostHog flag), so the env var
# is the master switch. The PostHog flag "launch_offer", when set to false, is
# an instant CLIENT-side kill for the launch UI without a redeploy; it cannot
# enable the offer on its own. To change the end date, edit OFFER_END_ISO in
# src/config/launchOffer.js.
REACT_APP_LAUNCH_OFFER_ENABLED=false
LAUNCH_OFFER_ENABLED=false

# ─── Invoice / receipt issuer (post-payment fiscal documents) ─────────
# IN-entity (Razorpay / INR) invoices snapshot these onto the row at
# issue time, so historic invoices preserve the issuer even if these
# values change later. The AE-entity (Ziina / AED) receipt uses a fixed
# CVPassport block by spec and reads no env vars.
INVOICE_SELLER_IN_NAME=Your legal or trade name
INVOICE_SELLER_IN_ADDRESS=Street, City, State, Postal code, India
INVOICE_SELLER_IN_PAN=
INVOICE_SELLER_IN_EMAIL=billing@mycvpassport.com
INVOICE_SELLER_IN_SUPPORT_EMAIL=billing@mycvpassport.com

# Base URL used in invoice emails for the deep-link back to the in-app
# /account/invoices/{id} page. Defaults to https://mycvpassport.com.
PUBLIC_BASE_URL=https://mycvpassport.com
