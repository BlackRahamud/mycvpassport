# src/coverLetterDataBank.generated.js is required at runtime and must stay tracked - do not ignore.
ghost-audit/

# Supabase CLI scratch dir — machine-specific link/version cache
supabase/.temp/

# Claude Code local permission cache — machine-specific
.claude/settings.local.json

# Pagination / PDF debug output (scripts/debug-t11-pagination.js,
# scripts/render-t11-real.js). Local diagnostics only — do not commit
# rendered PDFs or trace logs.
/out/

# Local screenshot output from scripts/screenshot-hr-post.mjs — design-review captures only
scripts/.screenshots/

# pdf.js worker copied from node_modules at build (scripts/copy-pdf-worker.mjs)
public/pdf.worker.min.js
